# 默认本地 backend/.env 优先；服务器可在启动环境设置 APP_CONFIG_SOURCE=environment
# 模型、搜索密钥只填写原始值，不带 Bearer 前缀
# ==================== LLM & Embedding ====================
# 阿里云百炼 API Key（必填）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=
# Copy the OpenAI-compatible Base URL from your own Bailian workspace
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MAIN_MODEL=deepseek-v4-pro-0813
LLM_FAST_MODEL=qwen3.8-flash
# 审核默认使用主模型且保留思考模式；审核请求为思维链和 JSON 预留更大的总输出额度
LLM_REVIEW_MODEL=deepseek-v4-pro-0813

# ==================== OpenRouter API ====================
# OpenRouter API Key（可选，用于多模型支持）
# 申请地址: https://openrouter.ai/
OPENROUTER_API_KEY=

# ==================== 文档解析 (DocMind) ====================
# 阿里云 DocMind 文档解析服务（可选）
# 申请地址: https://help.aliyun.com/zh/ram/user-guide/create-an-accesskey-pair
DOCMIND_ACCESS_KEY_ID=
DOCMIND_ACCESS_KEY_SECRET=

# ==================== 搜索 API ====================
# 博查搜索 API（必填）
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=

# Serper 搜索 API（可选）
SERPER_API_KEY=

# ==================== 行业资讯 API ====================
# 聚合数据 - 股票行情 API（可选）
# 申请地址: https://www.juhe.cn/docs/api/id/21
JUHE_STOCK_API_KEY=

# ==================== 招投标 API ====================
# 阿里云市场 - 招投标信息 API（可选）
# 申请地址: https://market.aliyun.com/detail/cmapi00063550
BID_APP_KEY=
BID_APP_SECRET=
BID_APP_CODE=

# ==================== Redis ====================
# Docker 默认配置，通常无需修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== PostgreSQL ====================
# Docker 默认配置，与 docker-compose.yml 保持一致
# 如果使用 Docker，无需修改以下配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_DB=industry_assistant

# ==================== Milvus ====================
# Docker 默认配置，通常无需修改
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== JWT 认证 ====================
# 建议生成一个随机密钥，生产环境务必修改
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==================== 其他配置 ====================
MEM_LIMIT=8073741824
TIMEZONE=Asia/Shanghai

# 可选：旧版 RAG 服务配置，仅使用该服务时填写
API_BASE_URL=http://localhost:9380
API_KEY=
DEFAULT_DATASET_ID=

# 本地演示：关闭启动及定时自动采集，手动调研不受影响
ENABLE_AUTO_COLLECTION=false
